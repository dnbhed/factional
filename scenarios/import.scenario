# Rasterising Azgaar's terrain (W2b) with detail (W3a), coasts (W3b), levels (W3c), rivers
# (W3d and W3e), and climate and biomes (W4a): a hand-made export of five cells imported into a
# map file, then read back. The tile counts, heights and climate were worked out by a separate
# script: every import here is -3 to 14 °C, 800 to 3000 mm and 4 biomes, its five cells' own.

# The whole map at 1 tile a pixel, with the default detail and coast: 357 ocean, 174 lake and
# 1069 land. Its length is in the snapshot.
world import crates/content/tests/fixtures/azgaar/raster.json target/raster.map

# What it wrote: the recipe names the export's fingerprint.
world info target/raster.map

assert world import crates/content/tests/fixtures/azgaar/raster.json target/off.map --region 30,30,20,20 == error: the region runs off the source map: pixels (30, 30) to (49, 49), and the map is 40 × 40 pixels
assert world import crates/content/tests/fixtures/azgaar/raster.json target/off.map --region 10,10 == error: --region needs four whole numbers, <x>,<y>,<width>,<height>, not 10,10
assert world import crates/content/tests/fixtures/azgaar/raster.json == error: world needs the form: world info <file>, world source <file>, or world import <export> <map> [--region <x>,<y>,<width>,<height>] [--scale <n>] [--seed <n>] [--detail <strength>] [--wavelength <pixels>] [--octaves <n>] [--shallows <metres>] [--specks <tiles>] [--levels <points>] [--level-specks <tiles>]

# Rougher detail, and another seed, in the recipe: heights -381.73 to 2241.02 m, and the
# recipe's detail in what `world info` says. The lengths are in the snapshot.
world import crates/content/tests/fixtures/azgaar/raster.json target/rough.map --seed 3 --detail 0.5 --wavelength 4 --octaves 2
world info target/rough.map
assert world import crates/content/tests/fixtures/azgaar/raster.json target/rough.map --octaves 9 == error: the detail needs 1 to 8 octaves, not 9

# The coast: shallows to 25 metres, and no specks removed; the sea's depth moves no tile
# between ocean and land, but specks do: 299 ocean, 181 lake and 1120 land above, and here
# 294, 183 and 1123. The recipe's coast is in what `world info` says.
world import crates/content/tests/fixtures/azgaar/raster.json target/coast.map --seed 3 --detail 0.5 --wavelength 4 --octaves 2 --shallows 25 --specks 0
world info target/coast.map
assert world import crates/content/tests/fixtures/azgaar/raster.json target/coast.map --specks 4097 == error: the coast's specks must be 0 to 4096 tiles, not 4097

# Levels every 10 of Azgaar's heights, with no plateaus or pits cleaned: levels 0 to 4, 357
# ocean, 174 lake and 1069 land as with the defaults. The recipe's levels are in what
# `world info` says.
world import crates/content/tests/fixtures/azgaar/raster.json target/levels.map --levels 10 --level-specks 0
world info target/levels.map
assert world import crates/content/tests/fixtures/azgaar/raster.json target/levels.map --levels 0.5 == error: the levels' spacing must be 1.00 to 80.00 of Azgaar's heights, not 0.50
assert world import crates/content/tests/fixtures/azgaar/raster.json target/levels.map --level-specks 4097 == error: the levels' specks must be 0 to 4096 tiles, not 4097

# Rivers: the same five cells with three rivers, Ford into the lake, Beck joining it and Rill off
# the map's edge. 77 of the 1069 land tiles are river, their beds carved never to rise from source
# to mouth; water stands at the level of its surface, and drops as land does.
world source crates/content/tests/fixtures/azgaar/rivers.json
assert world import crates/content/tests/fixtures/azgaar/rivers.json target/rivers.map == imported Rivers into rivers.map: 40 × 40 tiles in 1 × 1 chunks, 357 ocean, 174 lake, 77 river and 992 land (22 sand, 314 grass, 604 forest floor and 52 rock); heights -176.70 to 1922.19 m; temperatures -3 to 14 °C; precipitation 800 to 3000 mm; 4 biomes; levels 0 to 8, 494 ledges and 56 cliffs; 4882 bytes

# A region at scale 2: the rivers twice as wide, 141 river tiles.
world import crates/content/tests/fixtures/azgaar/rivers.json target/rivers-part.map --region 10,10,20,20 --scale 2 --seed 7
