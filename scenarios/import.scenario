# Rasterising Azgaar's terrain (W2b) with detail (W3a), coasts (W3b), levels (W3c), rivers
# (W3d and W3e), and climate and biomes (W4a): a hand-made export of five cells imported into a
# map file, then read back. The tile counts, heights and climate were worked out by a separate
# script: every import here is -3 to 14 °C, 800 to 3000 mm and 4 biomes, its five cells' own.

# The whole map at 1 tile a pixel, with the default detail and coast: 357 ocean, 174 lake and
# 1069 land. Its length is in the snapshot.
world import crates/content/tests/fixtures/azgaar/raster.json target/raster.map

# What it wrote: the recipe names the export's fingerprint.
world info target/raster.map

assert world import crates/content/tests/fixtures/azgaar/raster.json target/off.map --region 30,30,20,20 == error: the region runs off the source map: pixels (30, 30) to (49, 49), and the map is 40 × 40 pixels
assert world import crates/content/tests/fixtures/azgaar/raster.json target/off.map --region 10,10 == error: --region needs four whole numbers, <x>,<y>,<width>,<height>, not 10,10
assert world import crates/content/tests/fixtures/azgaar/raster.json == error: world needs the form: world info <file>, world source <file>, world suggestions <map>, world tile <map> <x>,<y>, world dismiss <map> <id> [<id>…], world restore <map> <id> [<id>…], or world import <export> <map> [--region <x>,<y>,<width>,<height>] [--scale <n>] [--seed <n>] [--detail <strength>] [--wavelength <pixels>] [--octaves <n>] [--shallows <metres>] [--specks <tiles>] [--levels <points>] [--level-specks <tiles>] [--foliage <scale>] [--tree-spacing <tiles>] [--shrub-spacing <tiles>] [--grass-spacing <tiles>]

# Rougher detail, and another seed, in the recipe: heights -381.73 to 2241.02 m, and the
# recipe's detail in what `world info` says. The lengths are in the snapshot.
world import crates/content/tests/fixtures/azgaar/raster.json target/rough.map --seed 3 --detail 0.5 --wavelength 4 --octaves 2
world info target/rough.map
assert world import crates/content/tests/fixtures/azgaar/raster.json target/rough.map --octaves 9 == error: the detail needs 1 to 8 octaves, not 9

# The coast: shallows to 25 metres, and no specks removed; the sea's depth moves no tile
# between ocean and land, but specks do: 299 ocean, 181 lake and 1120 land above, and here
# 294, 183 and 1123. The recipe's coast is in what `world info` says.
world import crates/content/tests/fixtures/azgaar/raster.json target/coast.map --seed 3 --detail 0.5 --wavelength 4 --octaves 2 --shallows 25 --specks 0
world info target/coast.map
assert world import crates/content/tests/fixtures/azgaar/raster.json target/coast.map --specks 4097 == error: the coast's specks must be 0 to 4096 tiles, not 4097

# Levels every 10 of Azgaar's heights, with no plateaus or pits cleaned: levels 0 to 4, 357
# ocean, 174 lake and 1069 land as with the defaults. The recipe's levels are in what
# `world info` says.
world import crates/content/tests/fixtures/azgaar/raster.json target/levels.map --levels 10 --level-specks 0
world info target/levels.map
assert world import crates/content/tests/fixtures/azgaar/raster.json target/levels.map --levels 0.5 == error: the levels' spacing must be 1.00 to 80.00 of Azgaar's heights, not 0.50
assert world import crates/content/tests/fixtures/azgaar/raster.json target/levels.map --level-specks 4097 == error: the levels' specks must be 0 to 4096 tiles, not 4097

# Foliage: trees, shrubs and grass scattered over the land, never closer than their spacing. At
# twice the chances, and closer together, many more stand.
world import crates/content/tests/fixtures/azgaar/raster.json target/foliage.map --foliage 2 --tree-spacing 1 --shrub-spacing 1 --grass-spacing 0.5
world info target/foliage.map
assert world import crates/content/tests/fixtures/azgaar/raster.json target/foliage.map --grass-spacing 8.01 == error: the foliage's grass spacing must be 0.00 to 8.00 tiles, not 8.01

# Rivers: the same five cells with three rivers, Ford into the lake, Beck joining it and Rill off
# the map's edge. 77 of the 1069 land tiles are river, their beds carved never to rise from source
# to mouth; water stands at the level of its surface, and drops as land does.
world source crates/content/tests/fixtures/azgaar/rivers.json
assert world import crates/content/tests/fixtures/azgaar/rivers.json target/rivers.map == imported Rivers into rivers.map: 40 × 40 tiles in 1 × 1 chunks, 357 ocean, 174 lake, 77 river and 992 land (22 sand, 314 grass, 604 forest floor and 52 rock); heights -176.70 to 1922.19 m; temperatures -3 to 14 °C; precipitation 800 to 3000 mm; 4 biomes; levels 0 to 8, 494 ledges and 56 cliffs; 159 plants (49 trees, 24 shrubs and 86 grass); 0 settlements, 0 routes, 0 points of interest, 0 cultures, 0 religions and 0 states suggested; 6571 bytes

# A region at scale 2: the rivers twice as wide, 141 river tiles.
world import crates/content/tests/fixtures/azgaar/rivers.json target/rivers-part.map --region 10,10,20,20 --scale 2 --seed 7

# Suggestions (W6b): raster.json's three settlements, three routes and two points of interest,
# each placed by its tile and an offset within it, worked by a separate script; and (W6e) its
# two cultures, two religions and two states, each with the tiles lying in its cells. The import
# counts them, `world info` counts them all, and `world suggestions` lists each.
world import crates/content/tests/fixtures/azgaar/raster.json target/places.map
world info target/places.map
world suggestions target/places.map

# A region drops what's outside it and cuts the routes at its edge: Highmoor, Pinewatch and Ash
# Peak fall outside, and the Coast road leaves and comes back, two stretches, route_2_1 and
# route_2_2.
world import crates/content/tests/fixtures/azgaar/raster.json target/places-part.map --region 10,10,20,20 --scale 2
world suggestions target/places-part.map

# The top-left corner holds none.
world import crates/content/tests/fixtures/azgaar/raster.json target/corner.map --region 0,0,10,10
assert world suggestions target/corner.map == corner.map: 0 settlements, 0 routes, 0 points of interest, 0 cultures, 0 religions and 0 states
assert world suggestions content/sample/factions.toml == error: this isn't a Factional map
assert world suggestions == error: world needs the form: world info <file>, world source <file>, world suggestions <map>, world tile <map> <x>,<y>, world dismiss <map> <id> [<id>…], world restore <map> <id> [<id>…], or world import <export> <map> [--region <x>,<y>,<width>,<height>] [--scale <n>] [--seed <n>] [--detail <strength>] [--wavelength <pixels>] [--octaves <n>] [--shallows <metres>] [--specks <tiles>] [--levels <points>] [--level-specks <tiles>] [--foliage <scale>] [--tree-spacing <tiles>] [--shrub-spacing <tiles>] [--grass-spacing <tiles>]

# Dismissing (W6c): a suggestion set aside stays on the map, marked. A route's own id dismisses
# every stretch of it, so route_2 sets aside both of the region's stretches: three of twelve.
assert world dismiss target/places-part.map route_2 poi_1 == dismissed route_2 and poi_1 in places-part.map; 3 of its 12 suggestions dismissed
world suggestions target/places-part.map
assert world dismiss target/places-part.map route_2_1 == error: route_2_1 is already dismissed with route_2
assert world dismiss target/places-part.map settlement_7 == error: there's no suggestion settlement_7 on the map; did you mean settlement_2?
assert world dismiss target/places-part.map route_0 route_0 == error: route_0 is named twice
assert world restore target/places-part.map route_2_2 == error: route_2_2 is dismissed with route_2; restore route_2
assert world restore target/places-part.map settlement_2 == error: settlement_2 isn't dismissed
assert world restore target/places-part.map poi_1 == restored poi_1 in places-part.map; 2 of its 12 suggestions dismissed
assert world dismiss target/places-part.map == error: world needs the form: world info <file>, world source <file>, world suggestions <map>, world tile <map> <x>,<y>, world dismiss <map> <id> [<id>…], world restore <map> <id> [<id>…], or world import <export> <map> [--region <x>,<y>,<width>,<height>] [--scale <n>] [--seed <n>] [--detail <strength>] [--wavelength <pixels>] [--octaves <n>] [--shallows <metres>] [--specks <tiles>] [--levels <points>] [--level-specks <tiles>] [--foliage <scale>] [--tree-spacing <tiles>] [--shrub-spacing <tiles>] [--grass-spacing <tiles>]

# On the whole map the Coast road is one route, route_2, dismissed by its own id. `world info`
# counts the dismissed.
assert world dismiss target/places.map route_2 settlement_2 == dismissed route_2 and settlement_2 in places.map; 2 of its 14 suggestions dismissed
world info target/places.map
world suggestions target/places.map

# Peoples (W6e): a culture, religion or state is on the map when a tile's nearest cell names it,
# and keeps its cells and people in the whole source beside its tiles on the map. Seafolk names
# no cell, so it's never suggested. In the region, both capitals fall outside: their links say
# so. A people is dismissed and restored like a place.
assert world dismiss target/places-part.map culture_2 state_2 == dismissed culture_2 and state_2 in places-part.map; 4 of its 12 suggestions dismissed
assert world dismiss target/places-part.map culture_3 == error: there's no suggestion culture_3 on the map; did you mean culture_1?
world suggestions target/places-part.map
assert world restore target/places-part.map culture_2 state_2 == restored culture_2 and state_2 in places-part.map; 2 of its 12 suggestions dismissed

# Territory (W6f): each tile lies in its nearest cell's culture, religion and state, and the
# count of each people's tiles comes from them. Tile (5, 5) lies in cell 0, which names none;
# (30, 8) in cell 1, Highfolk's, Old Ways' and Highmoor's; (20, 20) in cell 4, Highfolk's, Pine
# Faith's and Highmoor's, worked by a separate script.
world tile target/places.map 5,5
world tile target/places.map 30,8
world tile target/places.map 20,20
