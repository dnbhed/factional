{
  "$defs": {
    "choice": {
      "additionalProperties": false,
      "description": "An outcome or effects, or neither.",
      "not": {
        "required": [
          "outcome",
          "effects"
        ]
      },
      "properties": {
        "effects": {
          "additionalProperties": false,
          "description": "Effects written here, of the kinds an outcome has.",
          "properties": {
            "alignment": {
              "$ref": "#/$defs/delta"
            },
            "relations": {
              "description": "Shifts in how factions regard each other, applied after the standing changes, each direction stopping at -100 and 100. A direction is shifted at most once.",
              "items": {
                "$ref": "#/$defs/relation_shift"
              },
              "type": "array"
            },
            "standing": {
              "$ref": "#/$defs/standing"
            }
          },
          "type": "object"
        },
        "id": {
          "description": "The choice's id, unique within its stage.",
          "pattern": "^[a-z][a-z0-9_]*$",
          "type": "string"
        },
        "locks": {
          "description": "Every other quest, or stage of one, the choice can shut off for good, once each: quest for its gate (its step's requirements included), quest.stage for a stage. Loading refuses a lockout left out; one listed that can't happen is a warning.",
          "items": {
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)?$",
            "type": "string",
            "x-names": "quest"
          },
          "type": "array"
        },
        "next": {
          "description": "A later stage's id, or end for the end of the quest.",
          "pattern": "^[a-z][a-z0-9_]*$",
          "type": "string"
        },
        "outcome": {
          "description": "An outcome from outcomes.toml.",
          "pattern": "^[a-z][a-z0-9_]*$",
          "type": "string",
          "x-names": "outcome"
        }
      },
      "required": [
        "id",
        "next"
      ],
      "type": "object"
    },
    "delta": {
      "additionalProperties": false,
      "description": "The change to alignment.",
      "properties": {
        "good": {
          "description": "How far it moves this axis; left out, it doesn't.",
          "type": "number"
        },
        "law": {
          "description": "How far it moves this axis; left out, it doesn't.",
          "type": "number"
        }
      },
      "type": "object"
    },
    "quest": {
      "additionalProperties": false,
      "properties": {
        "giver": {
          "description": "Whose quest it is: a faction or a character, by id; left out, the world's own.",
          "pattern": "^[a-z][a-z0-9_]*$",
          "type": "string",
          "x-group": "Identity",
          "x-names": "party"
        },
        "name": {
          "description": "The quest's name, as shown.",
          "type": "string",
          "x-group": "Identity"
        },
        "requires": {
          "$ref": "#/$defs/requires",
          "description": "What must hold to start it.",
          "x-group": "Requirements"
        },
        "stages": {
          "description": "The stages, in order.",
          "items": {
            "$ref": "#/$defs/stage"
          },
          "minItems": 1,
          "type": "array",
          "x-group": "Stages"
        }
      },
      "required": [
        "name",
        "stages"
      ],
      "type": "object",
      "x-groups": [
        "Identity",
        "Requirements",
        "Stages"
      ]
    },
    "relation_shift": {
      "additionalProperties": false,
      "description": "Either between = [a, b], or from and to.",
      "oneOf": [
        {
          "not": {
            "anyOf": [
              {
                "required": [
                  "from"
                ]
              },
              {
                "required": [
                  "to"
                ]
              }
            ]
          },
          "required": [
            "between"
          ]
        },
        {
          "not": {
            "required": [
              "between"
            ]
          },
          "required": [
            "from",
            "to"
          ]
        }
      ],
      "properties": {
        "between": {
          "description": "Two factions whose regard for each other both shift.",
          "items": {
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string",
            "x-names": "faction"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "by": {
          "description": "How far each direction moves, -200 to 200.",
          "maximum": 200.0,
          "minimum": -200.0,
          "type": "number"
        },
        "from": {
          "description": "The faction whose regard shifts.",
          "pattern": "^[a-z][a-z0-9_]*$",
          "type": "string",
          "x-names": "faction"
        },
        "to": {
          "description": "The faction it regards.",
          "pattern": "^[a-z][a-z0-9_]*$",
          "type": "string",
          "x-names": "faction"
        }
      },
      "required": [
        "by"
      ],
      "type": "object"
    },
    "requires": {
      "additionalProperties": false,
      "description": "What must hold for the character doing the quest, all of it.",
      "properties": {
        "done": {
          "description": "Progress through other quests: quest (finished), quest.stage (reached) or quest.stage.choice (made).",
          "items": {
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*){0,2}$",
            "type": "string",
            "x-names": "quest"
          },
          "type": "array"
        },
        "member": {
          "description": "Factions the character must be in.",
          "items": {
            "description": "A faction's id.",
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string",
            "x-names": "faction"
          },
          "type": "array"
        },
        "not_member": {
          "description": "Factions the character must not be in.",
          "items": {
            "description": "A faction's id.",
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string",
            "x-names": "faction"
          },
          "type": "array"
        },
        "rank_at_least": {
          "additionalProperties": {
            "description": "A rank on the faction's ladder.",
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "description": "At least this rank in each faction, by faction id.",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "type": "object",
          "x-names-keys": "faction"
        },
        "standing": {
          "additionalProperties": {
            "description": "At least this, -100 to 100.",
            "maximum": 100.0,
            "minimum": -100.0,
            "type": "number"
          },
          "description": "Standing with each faction or character, by id.",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "type": "object",
          "x-names-keys": "party"
        },
        "within_tolerance": {
          "description": "Factions whose member tolerance the character must be within, as the faction pictures them.",
          "items": {
            "description": "A faction's id.",
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string",
            "x-names": "faction"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "stage": {
      "additionalProperties": false,
      "properties": {
        "choices": {
          "description": "What the character can choose here.",
          "items": {
            "$ref": "#/$defs/choice"
          },
          "minItems": 1,
          "type": "array"
        },
        "id": {
          "description": "The stage's id, unique within its quest; not end.",
          "pattern": "^[a-z][a-z0-9_]*$",
          "type": "string"
        },
        "requires": {
          "$ref": "#/$defs/requires",
          "description": "What must hold to reach it."
        }
      },
      "required": [
        "id",
        "choices"
      ],
      "type": "object"
    },
    "standing": {
      "additionalProperties": false,
      "description": "Standing, by faction or character id, -100 to 100.",
      "properties": {
        "characters": {
          "additionalProperties": {
            "description": "-100 to 100.",
            "maximum": 100.0,
            "minimum": -100.0,
            "type": "number"
          },
          "description": "By character id.",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "type": "object",
          "x-names-keys": "character"
        },
        "factions": {
          "additionalProperties": {
            "description": "-100 to 100.",
            "maximum": 100.0,
            "minimum": -100.0,
            "type": "number"
          },
          "description": "By faction id.",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "type": "object",
          "x-names-keys": "faction"
        }
      },
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": {
    "$ref": "#/$defs/quest"
  },
  "description": "Quests, each a table keyed by its id: a list of stages, each with choices (DESIGN.md §17.1).",
  "propertyNames": {
    "pattern": "^[a-z][a-z0-9_]*$"
  },
  "title": "quests.toml",
  "type": "object"
}
