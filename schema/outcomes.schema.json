{
  "$defs": {
    "delta": {
      "additionalProperties": false,
      "description": "The change to alignment.",
      "properties": {
        "good": {
          "description": "How far it moves this axis; left out, it doesn't.",
          "title": "Good",
          "type": "number",
          "x-sentence": {
            "says": 2,
            "text": "Moves good by {value}"
          }
        },
        "law": {
          "description": "How far it moves this axis; left out, it doesn't.",
          "title": "Law",
          "type": "number",
          "x-sentence": {
            "says": 2,
            "text": "Moves law by {value}"
          }
        }
      },
      "type": "object"
    },
    "outcome": {
      "additionalProperties": false,
      "properties": {
        "alignment": {
          "$ref": "#/$defs/delta",
          "title": "Alignment",
          "x-group": "Alignment"
        },
        "relations": {
          "description": "Shifts in how factions regard each other, applied after the standing changes, each direction stopping at -100 and 100. A direction is shifted at most once.",
          "items": {
            "$ref": "#/$defs/relation_shift"
          },
          "title": "Relations",
          "type": "array",
          "x-group": "Relations",
          "x-item": "Shift"
        },
        "standing": {
          "$ref": "#/$defs/standing",
          "title": "Standing",
          "x-group": "Standing"
        }
      },
      "type": "object",
      "x-groups": [
        "Alignment",
        "Standing",
        "Relations"
      ]
    },
    "relation_shift": {
      "additionalProperties": false,
      "description": "Either between = [a, b], or from and to.",
      "oneOf": [
        {
          "not": {
            "anyOf": [
              {
                "required": [
                  "from"
                ]
              },
              {
                "required": [
                  "to"
                ]
              }
            ]
          },
          "required": [
            "between"
          ]
        },
        {
          "not": {
            "required": [
              "between"
            ]
          },
          "required": [
            "from",
            "to"
          ]
        }
      ],
      "properties": {
        "between": {
          "description": "Two factions whose regard for each other both shift.",
          "items": {
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string",
            "x-names": "faction"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Between",
          "type": "array"
        },
        "by": {
          "description": "How far each direction moves, -200 to 200.",
          "maximum": 200.0,
          "minimum": -200.0,
          "title": "By",
          "type": "number"
        },
        "from": {
          "description": "The faction whose regard shifts.",
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "From",
          "type": "string",
          "x-names": "faction"
        },
        "to": {
          "description": "The faction it regards.",
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "To",
          "type": "string",
          "x-names": "faction"
        }
      },
      "required": [
        "by"
      ],
      "type": "object"
    },
    "standing": {
      "additionalProperties": false,
      "description": "Standing, by faction or character id, -100 to 100.",
      "properties": {
        "characters": {
          "additionalProperties": {
            "description": "-100 to 100.",
            "maximum": 100.0,
            "minimum": -100.0,
            "type": "number",
            "x-sentence": {
              "says": 3,
              "text": "Standing with {key} changes by {value}"
            }
          },
          "description": "By character id.",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "title": "Characters",
          "type": "object",
          "x-names-keys": "character"
        },
        "factions": {
          "additionalProperties": {
            "description": "-100 to 100.",
            "maximum": 100.0,
            "minimum": -100.0,
            "type": "number",
            "x-sentence": {
              "says": 3,
              "text": "Standing with {key} changes by {value}"
            }
          },
          "description": "By faction id.",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "title": "Factions",
          "type": "object",
          "x-names-keys": "faction"
        }
      },
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": {
    "$ref": "#/$defs/outcome"
  },
  "description": "Named bundles of effects, such as a quest's result, each a table keyed by its id (P-26).",
  "propertyNames": {
    "pattern": "^[a-z][a-z0-9_]*$"
  },
  "title": "outcomes.toml",
  "type": "object"
}
