{
  "$defs": {
    "alignment": {
      "additionalProperties": false,
      "description": "Where they stand on the two axes.",
      "properties": {
        "good": {
          "description": "Evil (-100) to good (100).",
          "maximum": 100.0,
          "minimum": -100.0,
          "type": "number"
        },
        "law": {
          "description": "Chaotic (-100) to lawful (100).",
          "maximum": 100.0,
          "minimum": -100.0,
          "type": "number"
        }
      },
      "required": [
        "law",
        "good"
      ],
      "type": "object"
    },
    "character": {
      "additionalProperties": false,
      "properties": {
        "alignment": {
          "$ref": "#/$defs/alignment",
          "x-group": "Where they stand"
        },
        "contacts": {
          "description": "The characters they pass news to under the ripple model. A contact works both ways, so list it on one side only (DESIGN.md §10.2).",
          "items": {
            "description": "A character's id.",
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string",
            "x-names": "character"
          },
          "type": "array",
          "x-group": "Contacts"
        },
        "inertia": {
          "description": "Their inertia profile, from balance.toml; left out, the default.",
          "pattern": "^[a-z][a-z0-9_]*$",
          "type": "string",
          "x-group": "Where they stand",
          "x-names": "profile"
        },
        "memberships": {
          "description": "The factions they start in.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "faction": {
                "description": "The faction's id.",
                "pattern": "^[a-z][a-z0-9_]*$",
                "type": "string",
                "x-names": "faction"
              },
              "rank": {
                "description": "A rank on its ladder; left out, the lowest.",
                "pattern": "^[a-z][a-z0-9_]*$",
                "type": "string"
              },
              "secret": {
                "default": false,
                "description": "Whether they start in it secretly, known only to the faction, its members and themself. The faction must allow secret members (DESIGN.md §10.4).",
                "type": "boolean"
              }
            },
            "required": [
              "faction"
            ],
            "type": "object"
          },
          "type": "array",
          "x-group": "Memberships"
        },
        "name": {
          "description": "The character's name, as shown.",
          "type": "string",
          "x-group": "Identity"
        },
        "standing": {
          "$ref": "#/$defs/standing",
          "x-group": "Standing"
        },
        "weights": {
          "$ref": "#/$defs/weights",
          "x-group": "Where they stand"
        }
      },
      "required": [
        "name",
        "alignment"
      ],
      "type": "object",
      "x-groups": [
        "Identity",
        "Where they stand",
        "Memberships",
        "Standing",
        "Contacts"
      ]
    },
    "standing": {
      "additionalProperties": false,
      "description": "Standing, by faction or character id, -100 to 100.",
      "properties": {
        "characters": {
          "additionalProperties": {
            "description": "-100 to 100.",
            "maximum": 100.0,
            "minimum": -100.0,
            "type": "number"
          },
          "description": "By character id.",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "type": "object",
          "x-names-keys": "character"
        },
        "factions": {
          "additionalProperties": {
            "description": "-100 to 100.",
            "maximum": 100.0,
            "minimum": -100.0,
            "type": "number"
          },
          "description": "By faction id.",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "type": "object",
          "x-names-keys": "faction"
        }
      },
      "type": "object"
    },
    "weights": {
      "additionalProperties": false,
      "description": "How much each axis counts when judging distance, 0 to 1, at least one above 0.",
      "properties": {
        "good": {
          "description": "0 to 1.",
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        "law": {
          "description": "0 to 1.",
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        }
      },
      "required": [
        "law",
        "good"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": {
    "$ref": "#/$defs/character"
  },
  "description": "Everyone in the world, the player included, each a table keyed by their id (DESIGN.md §13).",
  "propertyNames": {
    "pattern": "^[a-z][a-z0-9_]*$"
  },
  "title": "characters.toml",
  "type": "object"
}
