> form content/sample factions.toml city_watch
factions.toml › city_watch: The City Watch
Identity
  name = The City Watch
Where it stands
  alignment.law = 70.0
  alignment.good = 20.0
  # Cares about order far more than kindness.
  weights.law = 1.0
  weights.good = 0.25
Membership
  tolerance = 40.0
  member_tolerance = 50.0
  expel_standing_change: not set, -20.00
  leave_standing_change: not set, 0.00
  secret_members: not set, false (false or true)
Drift
  # The Watch gives a straying officer a hundred ticks to mend their ways.
  drift.policy = probation (ignore, flag, demote, expel or probation)
  drift.grace_ticks = 100
  drift.then = expel (demote or expel)
Ranks
  ranks[0].id = recruit
  ranks[1].id = sergeant
  ranks[1].requires.standing = 30.0
  ranks[2].id = captain
  ranks[2].requires.standing = 70.0
  # Captains are held to a stricter standard than the faction's member tolerance.
  ranks[2].tolerance = 25.0
